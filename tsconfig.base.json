{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@e-invoice/configuration": ["./libs/configuration/src/index.ts"],
      "@e-invoice/constants": ["./libs/constants/src/index.ts"],
      "@e-invoice/decorators": ["./libs/decorators/src/index.ts"],
      "@e-invoice/entities": ["./libs/entities/src/index.ts"],
      "@e-invoice/guards": ["./libs/guards/src/index.ts"],
      "@e-invoice/interceptors": ["./libs/interceptors/src/index.ts"],
      "@e-invoice/interfaces": ["./libs/interfaces/src/index.ts"],
      "@e-invoice/middlewares": ["./libs/middlewares/src/index.ts"],
      "@e-invoice/schemas": ["./libs/schemas/src/index.ts"],
      "@e-invoice/utils": ["./libs/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
